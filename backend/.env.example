# Copy this file to ".env" and fill in your details.

PORT=5000

# Email that will SEND the notification (Gmail example — use an "App Password", not your normal password)
EMAIL_SERVICE=gmail
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-app-password

# Email that will RECEIVE contact form submissions (defaults to EMAIL_USER if omitted)
EMAIL_TO=s.aliahsan222@gmail.com
